//@version=5
// Replica del bot Coinrule "Solana Range Trading"
// Logica: compra sul supporto del range (banda inferiore / ipervenduto),
// vende sulla resistenza (banda superiore). Funziona nei mercati laterali,
// soffre nei trend direzionali forti -> stop loss obbligatorio.
strategy("Coinrule Replica - Range Trading", overlay=true,
     initial_capital=10000, default_qty_type=strategy.percent_of_equity,
     default_qty_value=100, commission_type=strategy.commission.percent,
     commission_value=0.15, slippage=0)

bbLen   = input.int(20,  "Lunghezza Bollinger")
bbMult  = input.float(2.0, "Moltiplicatore dev. std", step=0.1)
rsiLen  = input.int(14,  "Lunghezza RSI")
rsiOS   = input.int(35,  "Soglia RSI ipervenduto")
slPerc  = input.float(5.0, "Stop loss %", step=0.5)

basis = ta.sma(close, bbLen)
dev   = bbMult * ta.stdev(close, bbLen)
upper = basis + dev
lower = basis - dev
rsi   = ta.rsi(close, rsiLen)

plot(basis, "BB Media",     color=color.orange)
plot(upper, "BB Superiore", color=color.red)
plot(lower, "BB Inferiore", color=color.green)

// Compra sul fondo del range, vendi sul tetto
longCond = close < lower and rsi < rsiOS
exitCond = close > upper

if longCond and strategy.position_size == 0
    strategy.entry("Long", strategy.long)

if exitCond and strategy.position_size > 0
    strategy.close("Long", comment="Top del range")

if strategy.position_size > 0
    strategy.exit("SL", "Long", stop=strategy.position_avg_price * (1 - slPerc / 100))
