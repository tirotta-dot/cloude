//@version=5
// Replica del bot Coinrule "Bollinger Bands and RSI Short Selling"
// Logica: SHORT quando il prezzo rompe la banda di Bollinger superiore
// con RSI in ipercomprato (mean reversion). Chiusura sulla banda media
// o quando l'RSI rientra. Stop loss percentuale di protezione.
// NOTA: e' una strategia SHORT -> su spot serve un exchange con margin/futures.
strategy("Coinrule Replica - BB + RSI Short", overlay=true,
     initial_capital=10000, default_qty_type=strategy.percent_of_equity,
     default_qty_value=100, commission_type=strategy.commission.percent,
     commission_value=0.15, slippage=0)

// ── Input ──────────────────────────────────────────────────────────
bbLen     = input.int(20,  "Lunghezza Bollinger", minval=5)
bbMult    = input.float(2.0, "Moltiplicatore dev. std", step=0.1)
rsiLen    = input.int(14,  "Lunghezza RSI", minval=2)
rsiOB     = input.int(70,  "Soglia RSI ipercomprato", minval=50, maxval=95)
rsiExit   = input.int(50,  "RSI uscita", minval=20, maxval=70)
slPerc    = input.float(4.0, "Stop loss %", step=0.5)

// ── Indicatori ─────────────────────────────────────────────────────
basis = ta.sma(close, bbLen)
dev   = bbMult * ta.stdev(close, bbLen)
upper = basis + dev
lower = basis - dev
rsi   = ta.rsi(close, rsiLen)

plot(basis, "BB Media",     color=color.orange)
plot(upper, "BB Superiore", color=color.red)
plot(lower, "BB Inferiore", color=color.green)

// ── Condizioni ─────────────────────────────────────────────────────
// Prezzo sopra la banda superiore + RSI ipercomprato = eccesso rialzista
shortCond = close > upper and rsi > rsiOB
// Uscita: ritorno alla media oppure RSI normalizzato
coverCond = close < basis or rsi < rsiExit

if shortCond and strategy.position_size == 0
    strategy.entry("Short", strategy.short)

if coverCond and strategy.position_size < 0
    strategy.close("Short", comment="Mean reversion")

// Stop loss di protezione
if strategy.position_size < 0
    strategy.exit("SL", "Short", stop=strategy.position_avg_price * (1 + slPerc / 100))
