//@version=5
// Replica del bot Coinrule "Buy Bitcoin + Stop Loss And Take Profit"
// Logica: compra su un semplice segnale di momentum (chiusura sopra la
// EMA breve) e gestisce l'uscita SOLO con take profit e stop loss fissi.
// E' il template piu' semplice di Coinrule: tutta la performance dipende
// dal rapporto TP/SL e dal regime di mercato.
strategy("Coinrule Replica - Buy + SL/TP", overlay=true,
     initial_capital=10000, default_qty_type=strategy.percent_of_equity,
     default_qty_value=100, commission_type=strategy.commission.percent,
     commission_value=0.15, slippage=0)

emaLen = input.int(20, "EMA segnale")
tpPerc = input.float(6.0, "Take profit %", step=0.5)
slPerc = input.float(3.0, "Stop loss %",  step=0.5)

ema = ta.ema(close, emaLen)
plot(ema, "EMA", color=color.orange)

if ta.crossover(close, ema) and strategy.position_size == 0
    strategy.entry("Long", strategy.long)

if strategy.position_size > 0
    strategy.exit("TP/SL", "Long",
         limit=strategy.position_avg_price * (1 + tpPerc / 100),
         stop =strategy.position_avg_price * (1 - slPerc / 100))
