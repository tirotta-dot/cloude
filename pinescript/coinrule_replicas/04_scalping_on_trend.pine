//@version=5
// Replica del bot Coinrule "Maximized Scalping On Trend"
// Logica: solo in uptrend (EMA veloce > EMA lenta) compra i piccoli pullback
// (RSI in raffreddamento) e prende profitto rapido con TP/SL stretti.
// Pensato per timeframe brevi (15m-1h), molte operazioni piccole.
strategy("Coinrule Replica - Scalping On Trend", overlay=true,
     initial_capital=10000, default_qty_type=strategy.percent_of_equity,
     default_qty_value=100, commission_type=strategy.commission.percent,
     commission_value=0.15, slippage=0)

fastLen  = input.int(20, "EMA veloce")
slowLen  = input.int(50, "EMA lenta")
rsiLen   = input.int(14, "Lunghezza RSI")
rsiDip   = input.int(45, "RSI pullback (sotto)")
tpPerc   = input.float(2.0, "Take profit %", step=0.25)
slPerc   = input.float(1.5, "Stop loss %",  step=0.25)

emaFast = ta.ema(close, fastLen)
emaSlow = ta.ema(close, slowLen)
rsi     = ta.rsi(close, rsiLen)

plot(emaFast, "EMA veloce", color=color.teal)
plot(emaSlow, "EMA lenta",  color=color.orange)

inUptrend = emaFast > emaSlow and close > emaSlow
longCond  = inUptrend and rsi < rsiDip

if longCond and strategy.position_size == 0
    strategy.entry("Long", strategy.long)

if strategy.position_size > 0
    strategy.exit("TP/SL", "Long",
         limit=strategy.position_avg_price * (1 + tpPerc / 100),
         stop =strategy.position_avg_price * (1 - slPerc / 100))
